{
    "name": "YouTube Negative Filter Extension",
    "description": "Applies a negative filter to YouTube recommendations.",
    "version": "1.0",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "manifest_version": 3,
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": ["content.js"]
        }
    ],
    "action": {
      "default_popup": "main.html"
    }
}